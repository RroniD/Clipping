# Copy this file to .env and fill in your own values. .env is git-ignored.
# Register an app at https://dev.twitch.tv/console/apps to get these.
# Without them Stage 1 still runs, it just skips the viewer-clips signal.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Stage 1b AI judge. Create a key at https://platform.claude.com (API keys).
# Without it the tool still runs, it just skips the judge.
ANTHROPIC_API_KEY=
